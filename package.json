{
  "name": "mercari-line-bot-v2",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "richmenu:generate": "tsx scripts/generateRichMenuImage.ts",
    "richmenu:setup": "tsx scripts/setupRichMenu.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@line/bot-sdk": "^9.7.1",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "openai": "^4.77.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
